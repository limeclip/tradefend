generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                   String         @id @default(uuid())
  supabaseUserId       String         @unique
  email                String         @unique
  fullName             String?
  avatarUrl            String?
  subscriptionStatus   String?
  subscriptionPlan     String?
  checksUsedThisMonth  Int            @default(0)
  monthlyResetDate     DateTime?
  subscriptionExpiresAt DateTime?
  payproSubscriptionId String?
  telegramChatId       String?        @unique
  /// Feature flag for AI Trade Guardian (can also be enabled via Pro subscription).
  guardianEnabled      Boolean        @default(false)
  /// Daily counter for Safe Position Builder (Free: max 3/day).
  positionsBuiltToday  Int            @default(0)
  positionsBuiltDate   DateTime?
  /// Synced count of UserPosition rows with status OPEN (updated in position APIs).
  openPositionsCount   Int            @default(0)
  lastWeeklyInsightAt  DateTime?
  weeklyInsightCount   Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  searchHistory        SearchHistory[]
  tokenChecks          TokenCheck[]
  favorites            Favorite[]
  watchlistItems       WatchlistItem[]
  notifications        Notification[]
  payproOrders         PayProOrder[]
  userActivities       UserActivity[]
  positionPlans        PositionPlan[]
  userPositions        UserPosition[]
  weeklyInsights       WeeklyInsight[]
}

model WeeklyInsight {
  id              String   @id @default(uuid())
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  stats           Json
  summary         String
  recommendations Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserPosition {
  id                  String    @id @default(uuid())
  userId              String
  tokenAddress        String
  ticker              String?
  chain               String?
  entryPrice          Float
  positionSizePercent Float?
  positionSizeUsdt    Float?
  stopLossPrice       Float
  takeProfitPrice     Float
  status              String    @default("OPEN")
  aiPlanId            String?
  /// Last known risk level from watchlist / monitor (for deterioration alerts).
  lastRiskLevel       String?
  lastPriceUsd        Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  closedAt            DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tokenAddress])
}

model PositionPlan {
  id                  String   @id @default(uuid())
  userId              String
  tokenAddress        String
  ticker              String?
  chain               String?
  entryPrice          Float
  positionSizePercent Float
  positionSizeUsdt    Float?
  stopLossPercent     Float
  takeProfitPercent   Float
  aiSummary           String
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tokenAddress])
}

model SearchHistory {
  id          String    @id @default(uuid())
  userId      String
  query       String
  queryType   String
  createdAt   DateTime  @default(now())
  tokenCheck  TokenCheck?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenQuery String
  createdAt  DateTime @default(now())

  @@unique([userId, tokenQuery])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model WatchlistItem {
  id             String    @id @default(uuid())
  userId         String
  tokenAddress   String
  ticker         String?
  chain          String?
  addedAt        DateTime  @default(now())
  lastCheckedAt  DateTime?
  lastRiskScore  Int?
  lastRiskLevel  String?
  notifyOnChange Boolean   @default(true)
  notes          Json?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenAddress])
  @@index([userId])
  @@index([lastCheckedAt])
}

model TokenCheck {
  id                String        @id @default(uuid())
  userId            String
  searchHistoryId   String?       @unique
  ticker            String?
  tokenAddress      String?
  chain             String?
  contractScore     Int?
  liquidityScore    Int?
  volatilityScore   Int?
  overallRisk       RiskLevel
  notes             Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchHistory     SearchHistory? @relation(fields: [searchHistoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tokenAddress])
  @@index([ticker])
}

model PayProOrder {
  id               String   @id @default(uuid())
  orderId          String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  amountUsd        Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  status           String   @default("pending")
  payproCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'token_check' | 'compare' | 'watchlist_refresh' | 'position_builder' и т.д.
  tokenCount Int?    // сколько токенов (для compare)
  address   String?  // адрес токена (для token_check)
  metadata  Json?    // запас
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// Curated low-risk tokens for the Proven Safe List (refreshed by cron).
model CuratedToken {
  id           String    @id @default(uuid())
  tokenAddress String
  chain        String
  ticker       String?
  riskScore    Int
  riskLevel    String
  addedAt      DateTime  @default(now())
  addedBy      String?
  reasonShort  String
  reasonFull   String?
  expiryDate   DateTime?

  @@unique([tokenAddress, chain])
  @@index([addedAt])
  @@index([riskLevel])
}

/// Cached risk reports for public shareable token pages (refreshed every few hours).
model TokenCache {
  id           String   @id @default(uuid())
  tokenAddress String
  chain        String
  reportJson   Json
  expiresAt    DateTime
  analyzedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tokenAddress, chain])
  @@index([tokenAddress])
  @@index([expiresAt])
}
